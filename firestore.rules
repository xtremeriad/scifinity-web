// SCIFINITY Firestore rules foundation.
//
// IMPORTANT: Keep all access closed until the owner UID and the public-read
// publication rules are reviewed and deployed. The Firebase console may still
// show the original deny-all rules until these are deployed with Firebase CLI.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /homepageBanners/{bannerId} {
      allow read: if resource.data.status == 'PUBLISHED';

      allow create, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}